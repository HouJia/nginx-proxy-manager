# LAN HTTP：家庭导航 /index/（内网免 TLS）
# 宿主机 88 → 容器 80；server_name 为 NAS LAN IP，不经过 Force SSL
# 部署：追加到 NPM 容器 /data/nginx/custom/http.conf 后 nginx -s reload

server {
    listen 80;
    listen [::]:80;
    server_name 192.168.0.6;

    access_log /data/logs/index-lan-http_access.log;
    error_log /data/logs/index-lan-http_error.log warn;

    location = / { return 302 /index/; }
    location = /index { return 301 /index/; }
    location ^~ /index/ {
        alias /data/nginx/custom/welcome/;
        index index.html;
    }

    location / { return 404; }
}
